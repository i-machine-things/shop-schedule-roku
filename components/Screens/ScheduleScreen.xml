<?xml version="1.0" encoding="utf-8" ?>
<component name="ScheduleScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/Screens/ScheduleScreen.brs" />
    <interface>
        <field id="reconfigure" type="boolean" value="false" />
        <function name="screenShown" />
    </interface>

    <children>
        <Rectangle width="1920" height="1080" color="0x07070FFF" />

        <!-- App header -->
        <Rectangle id="header" width="1920" height="70" color="0x0B0B18FF">
            <Label id="titleLabel" text="SHOP SCHEDULE" translation="[30, 20]" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="metaLabel" text="" translation="[1020, 14]" horizAlign="right" width="870" font="font:SmallSystemFont" color="0x888888FF" />
            <Label id="clockLabel" text="" translation="[1020, 36]" horizAlign="right" width="870" font="font:SmallSystemFont" color="0x4AAFFFFF" />
        </Rectangle>

        <!-- Column labels -- fixed, matches the web kiosk's <thead> row. x offsets
             must stay in sync with m.COLS in ScheduleScreen.brs. -->
        <Rectangle id="columnHeaderRow" width="1920" height="38" translation="[0, 70]" color="0x0D0D20FF">
            <Label text="JOB"         translation="[40, 10]"   font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="CUSTOMER"    translation="[240, 10]"  font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="DESCRIPTION" translation="[580, 10]"  font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="OPER"        translation="[1450, 10]" font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="CURR WC"     translation="[1620, 10]" font="font:SmallBoldSystemFont" color="0x7799FFFF" />
        </Rectangle>

        <!-- Sticky work-center header -- stays fixed, shows whichever section is
             currently scrolled to the top; replaced by the next section's info
             once that section reaches the top, matching the web kiosk's behavior. -->
        <Group id="stickyHeader" translation="[0, 108]">
            <Rectangle id="stickyHeaderBg" width="1920" height="56" color="0x1A1A1AFF" />
            <Rectangle id="stickyAccent" width="6" height="56" color="0x666666FF" />
            <Label id="stickyWcLabel" text="" translation="[30, 14]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="stickyDeptLabel" text="" translation="[360, 20]" font="font:SmallSystemFont" color="0x999999FF" />
        </Group>

        <!-- Scroll viewport: below the app header, column labels, AND the sticky
             WC header. clippingRect is required -- without it, scrolled rows
             render on top of/behind the headers above instead of staying
             confined below them. -->
        <Group id="viewport" translation="[0, 164]" clippingRect="[0, 0, 1920, 916]">
            <Group id="scrollContent" translation="[0, 0]" />
        </Group>

        <!-- Connection-lost banner -- overlays without wiping the last good schedule -->
        <Rectangle id="errorBanner" width="1920" height="40" translation="[0, 1040]" color="0x2B0D0DFF" visible="false">
            <Label id="errorLabel" text="" translation="[30, 8]" font="font:SmallSystemFont" color="0xFF8888FF" />
        </Rectangle>

        <Label id="loadingLabel" text="Loading schedule..." translation="[760, 520]" font="font:LargeSystemFont" color="0x4AAFFFFF" />

        <ScheduleTask id="scheduleTask" />
        <Timer id="refreshTimer" repeat="true" duration="60" />
        <Timer id="scrollTimer" repeat="true" duration="0.03" />
        <Timer id="pauseTimer" repeat="false" />
        <Timer id="clockTimer" repeat="true" duration="1" />
        <!-- Resets Roku's idle/screensaver timer -- see onHeartbeat() in the .brs -->
        <Timer id="heartbeatTimer" repeat="true" duration="90" />
    </children>
</component>
