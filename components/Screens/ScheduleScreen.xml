<?xml version="1.0" encoding="utf-8" ?>
<component name="ScheduleScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/Screens/ScheduleScreen.brs" />
    <interface>
        <field id="reconfigure" type="boolean" value="false" />
        <function name="screenShown" />
    </interface>

    <children>
        <Rectangle width="1920" height="1080" color="0x07070FFF" />

        <!-- App header. metaLabel/clockLabel need real vertical separation --
             font:SmallSystemFont renders taller than a 22px gap allows; the
             first version had the clock overlapping the report/thru date line. -->
        <Rectangle id="header" width="1920" height="92" color="0x0B0B18FF">
            <Label id="titleLabel" text="SHOP SCHEDULE" translation="[30, 30]" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="metaLabel" text="" translation="[1020, 12]" horizAlign="right" width="870" font="font:SmallSystemFont" color="0x888888FF" />
            <Label id="clockLabel" text="" translation="[1020, 50]" horizAlign="right" width="870" font="font:SmallSystemFont" color="0x4AAFFFFF" />
        </Rectangle>

        <!-- Column labels -- fixed, matches the web kiosk's <thead> row. x offsets
             must stay in sync with m.COLS in ScheduleScreen.brs. -->
        <Rectangle id="columnHeaderRow" width="1920" height="38" translation="[0, 92]" color="0x0D0D20FF">
            <Label text="JOB"         translation="[40, 10]"   font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="CUSTOMER"    translation="[240, 10]"  font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="DESCRIPTION" translation="[580, 10]"  font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="OPER"        translation="[1450, 10]" font="font:SmallBoldSystemFont" color="0x7799FFFF" />
            <Label text="CURR WC"     translation="[1620, 10]" font="font:SmallBoldSystemFont" color="0x7799FFFF" />
        </Rectangle>

        <!-- Sticky work-center header -- always visible, always shows whichever
             section's rows currently occupy the top of the viewport. Kept
             deliberately simple (no visibility toggling based on scroll
             position) after two real-hardware bugs from timing-based show/hide
             logic -- see CODING_NOTES.md "Sticky header v2". -->
        <Group id="stickyHeader" translation="[0, 130]">
            <Rectangle id="stickyHeaderBg" width="1920" height="56" color="0x1A1A1AFF" />
            <Rectangle id="stickyAccent" width="6" height="56" color="0x666666FF" />
            <Label id="stickyWcLabel" text="" translation="[30, 14]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
            <Label id="stickyDeptLabel" text="" translation="[360, 20]" font="font:SmallSystemFont" color="0x999999FF" />
        </Group>

        <!-- Scroll viewport: below the app header, column labels, AND the sticky
             WC header. clippingRect is required -- without it, scrolled rows
             render on top of/behind the headers above instead of staying
             confined below them. -->
        <Group id="viewport" translation="[0, 186]" clippingRect="[0, 0, 1920, 894]">
            <Group id="scrollContent" translation="[0, 0]" />
        </Group>

        <!-- Connection-lost banner -- overlays without wiping the last good schedule -->
        <Rectangle id="errorBanner" width="1920" height="40" translation="[0, 1040]" color="0x2B0D0DFF" visible="false">
            <Label id="errorLabel" text="" translation="[30, 8]" font="font:SmallSystemFont" color="0xFF8888FF" />
        </Rectangle>

        <Label id="loadingLabel" text="Loading schedule..." translation="[760, 520]" font="font:LargeSystemFont" color="0x4AAFFFFF" />

        <ScheduleTask id="scheduleTask" />
        <!-- "Ghost video" screensaver prevention: Video.enableScreenSaverWhilePlaying
             defaults to false, which should block Roku's screensaver while ANY
             video is playing, regardless of size (an ECP-keypress "heartbeat"
             was tried first and confirmed NOT to work on real hardware -- see
             CODING_NOTES.md). STILL UNDER TEST: the streamFormat fix got it
             further (state went none -> buffering, confirmed via telnet) but
             it then got stuck in "buffering" forever and never reached
             "playing" -- real decoder stall, not a culling/format-detection
             issue. Root cause found: media/ghost.mp4 was 16x16px at 5fps,
             which is plausibly below what Roku's hardware decoder is
             validated for even though desktop players handle it fine.
             Re-encoded at 128x128/24fps/H.264 Constrained Baseline with
             -movflags +faststart -- confirm via telnet before trusting this.
             Render size/opacity here (80x80, 0.15) are still from the
             size-testing round and should shrink back down once playback is
             actually confirmed working. Real video node, not a Task -- video
             playback isn't subject to the MAIN|TASK-thread restriction
             roUrlTransfer has. -->
        <Video id="ghostVideo" width="80" height="80" translation="[0, 0]" opacity="0.15" loop="true" enableScreenSaverWhilePlaying="false" />
        <Timer id="refreshTimer" repeat="true" duration="60" />
        <Timer id="scrollTimer" repeat="true" duration="0.03" />
        <Timer id="pauseTimer" repeat="false" />
        <Timer id="clockTimer" repeat="true" duration="1" />
        <!-- Resumes auto-scroll this long after the last manual Up/Down press -->
        <Timer id="manualPauseTimer" repeat="false" duration="10" />
        <!-- Temporary diagnostic -- unconditional poll, since if ghostVideo's
             state field never changes at all, the "state" field observer alone
             never fires even once, telling us nothing. Remove with the rest of
             the ghost video diagnostics once the real fix is confirmed. -->
        <Timer id="ghostPollTimer" repeat="true" duration="15" />
    </children>
</component>
