<?xml version="1.0" encoding="utf-8" ?>
<!-- roUrlTransfer is a MAIN|TASK-only component -- it cannot be created or
     used directly in a Scene-graph (render-thread) component's script.
     ScheduleScreen.brs did exactly that for the screensaver-prevention
     heartbeat and it was fatal: "Interface not a member of BrightScript
     Component", straight to the debugger, not a catchable error -- try/catch
     around it never had a chance. This Task runs the whole keepalive loop on
     its own thread instead, which is where roUrlTransfer is actually legal. -->
<component name="HeartbeatTask" extends="Task">
    <script type="text/brightscript" uri="pkg:/components/Tasks/HeartbeatTask.brs" />
</component>
